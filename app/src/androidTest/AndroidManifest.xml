<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- AGP supplies the runner name from testInstrumentationRunner. This is the test APK only. -->
    <application android:testOnly="true" android:label="Tap practice">
        <activity
            android:name="org.localwake.app.test.TapPracticeActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
    <instrumentation
        android:name="org.localwake.app.SamsungUpgradeInstrumentation"
        android:targetPackage="org.localwake.app"
        android:functionalTest="true"
        android:handleProfiling="false"
        android:label="UnlockTime device verification" />
</manifest>
